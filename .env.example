# Copy to .env and fill in the blanks. Variable names match app/config.py.

# --- AWS (required) ---
# Leave both keys empty to use the default credential chain (AWS profile, SSO, instance role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=default
AWS_REGION=us-east-1
S3_BUCKET=

# --- Bedrock models ---
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

# --- Pinecone (required) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=atlas-enterprise-ai-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

# --- PostgreSQL (required) ---
# e.g. postgresql://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=

# --- App behaviour ---
MIN_RELEVANCE=0.25
MAX_UPLOAD_BYTES=10485760
HITL_ENABLED=true
MEMORY_TURNS=6

# --- Rius observability (optional) ---
RIUS_API_KEY=
RIUS_SERVICE_NAME=atlas-enterprise-ai
RIUS_DISABLED=false
